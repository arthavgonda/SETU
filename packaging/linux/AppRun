#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
if [ -d "$HERE/usr/lib/setu/espeak-ng-data" ]; then
  export ESPEAK_DATA_PATH="$HERE/usr/lib/setu"
fi
case "${1:-}" in
  --window) shift; exec "$HERE/usr/bin/setu-ui" "$@" ;;
  --daemon) shift; exec "$HERE/usr/bin/setu-daemon" "$@" ;;
esac
exec "$HERE/usr/bin/setu-shell" "$@"
