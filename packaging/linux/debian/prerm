#!/bin/sh
set -e
if [ "$1" = "remove" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --global disable setu-daemon.service setu-shell.service >/dev/null 2>&1 || true
fi
if [ "$1" = "remove" ] && [ -x /usr/libexec/setu/setu-system ]; then
  /usr/libexec/setu/setu-system --uninstall >/dev/null 2>&1 || true
fi
exit 0
