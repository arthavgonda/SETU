<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>ai.setu.Setu</string>
    <key>CFBundleName</key>
    <string>Setu</string>
    <key>CFBundleDisplayName</key>
    <string>Setu</string>
    <key>CFBundleExecutable</key>
    <string>setu-shell</string>
    <key>CFBundleIconFile</key>
    <string>Setu.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@BUILD@</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Setu listens for its name and then for your request. Nothing is processed before you say its name, and audio is never stored.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Setu controls other apps only when you ask it to, for example to open a new window or play music.</string>
    <key>NSCameraUsageDescription</key>
    <string>Setu uses the camera only when you ask it to: to scan a Wi-Fi QR code, or to check it's you before it uses a saved password. The camera closes right after, and no picture is kept.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Setu needs this only to mute one app when you ask, for example "mute the game". It never records sound.</string>
    <key>LSEnvironment</key>
    <dict>
        <key>QV4_FORCE_INTERPRETER</key>
        <string>1</string>
    </dict>
</dict>
</plist>
